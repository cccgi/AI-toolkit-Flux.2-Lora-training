# Generated by setup — machine-specific, never commit
setup/paths.json
.venv/
venv/

# Downloaded models (large binaries — users run setup/download_models.py)
models/face/*.onnx
models/upscale/*.pth

# Training data / outputs (user-specific, potentially large and/or private)
datasets/
output/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# OS cruft
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Logs
*.log
